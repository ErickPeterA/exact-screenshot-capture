# PostgreSQL self-hosted. Never expose this value to the browser.
DATABASE_URL=postgresql://jornada_app:PASSWORD@postgres-main:5432/jornada

# Public origin used when createJourneyInvite returns the shareable URL.
PUBLIC_APP_URL=https://jornada.vgresultados.com.br

# Base64-encoded 32-byte key used only by the server to encrypt recoverable invite tokens.
# Generate with: openssl rand -base64 32
JOURNEY_LINK_ENCRYPTION_KEY=CHANGE_ME_TO_A_BASE64_ENCODED_32_BYTE_KEY

# Internal CRM endpoint used only by the Jornada server for SSO code exchange.
CRM_INTERNAL_URL=http://crm-projetos-app:3000
JOURNEY_SSO_SECRET=CHANGE_ME_TO_THE_SHARED_SERVER_SECRET

# Local-only administrative access. Never enable this in production.
DEV_BYPASS_JOURNEY_ADMIN=false

# Shared secret used only by the Jornada server when sending events to the CRM.
JOURNEY_EVENTS_SECRET=CHANGE_ME_TO_THE_SHARED_EVENTS_SECRET

